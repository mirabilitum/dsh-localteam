+    expect(await fixtureUnder.identity.manifest('s-1')).toEqual({ ok: false, reason: 'outside-work' })
+    expect(await fixtureUnder.identity.exportArchive('s-1')).toEqual({ ok: false, reason: 'outside-work' })
